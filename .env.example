# Copy to .env.local for local development, or set these in
# Vercel → Settings → Environment Variables for production.
#
# Local API routes only run under `vercel dev` — plain `npm run dev` is Vite
# alone and will 404 on /api/ai.

# Google AI Studio key: https://aistudio.google.com/apikey
# Server-side only. Never prefix with VITE_ — that would inline it into the
# browser bundle and publish the key to every visitor.
GEMINI_API_KEY=

# Salt for hashing IP addresses into fallback user IDs. Any long random string.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Without it the hashes are just plain SHA-256 of an IP, which is cheap to
# reverse by brute force, so anyone could work out another visitor's rate-limit
# bucket. Not catastrophic, but there's no reason to leave it unset.
UID_SALT=

# Injected automatically by the Vercel Upstash integration — do not set by hand.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
